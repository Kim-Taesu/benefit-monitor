      "emart24.co.kr",
      "www.emart24.co.kr"
    ],
    "routes": [
      "https://emart24.co.kr/service/alliance"
    ],
    "feed_url": null,
    "html_url": "https://emart24.co.kr/service/alliance",
    "article_path_pattern": "/service/alliance",
    "keywords": [
      "제휴"
    ],
    "collection_scope": "공식 제휴 서비스 안내 · 행사 전체·앱 잔량 미포함"
  },
  "runbook": {
    "checked_at": "2026-11-06",
    "entry_urls": [
      "https://emart24.co.kr/service/alliance"
    ],
    "access": {
      "robots": "partly_disallowed",
      "rendering": "server_html",
      "detail_access": "get",
      "conditions_in": "unknown",
