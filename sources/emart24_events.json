{
  "$schema": "../schema/source.schema.json",
  "schema_version": 1,
  "id": "emart24_events",
  "name": "이마트24 진행 중 이벤트",
  "status": "active",
  "collect": {
    "tier": "C",
    "domains": [
      "emart24.co.kr",
      "www.emart24.co.kr"
    ],
    "routes": [
      "https://emart24.co.kr/event/ing"
    ],
    "feed_url": null,
    "html_url": "https://emart24.co.kr/event/ing",
    "article_path_pattern": "/event/\\d+",
    "keywords": [
      "이벤트",
      "할인",
      "혜택",
      "쿠폰",
      "제휴",
      "프로모션",
      "스탬프",
      "증정"
    ],
    "ai_review": false,
    "collection_scope": "이마트24 진행 중 이벤트 목록의 제목·게시 기간 · 상세 조건은 이미지라 사람 확인 필요 · 앱 잔량 미포함"
  },
  "runbook": {
    "checked_at": "2026-11-06",
    "entry_urls": [
      "https://emart24.co.kr/event/ing"
    ],
    "access": {
      "robots": "partly_disallowed",
      "rendering": "server_html",
      "detail_access": "get",
      "conditions_in": "image",
      "notes": [
        "상세 /event/<번호>에는 제목·기간만 글이고 조건은 이미지다."
      ]
    },
    "extraction": [
      "a.eventWrap 카드의 /event/<번호> 링크를 읽는다. 카드 글은 \"기간 제목\" 순서라 \"제목 (기간)\"으로 바꾼다."
    ],
    "pitfalls": [
      "ai_review: false. 상세 조건이 이미지라 유료 AI 조사가 읽을 것이 없다.",
      "목록 기간은 게시 기간이다. 검증된 혜택 기간으로 쓰지 않는다."
    ],
    "manual_check": [
      "python3 -m benefit_monitor.source_registry probe emart24_events"
    ],
    "on_failure": [
      "robots 403·서버 오류·TLS 오류는 실패로 기록하고 우회하지 않는다(robots 404만 허용).",
      "\"No matching official articles\"면 목록 구조나 제목 단어가 바뀐 것이다. 원문 HTML을 저장해 링크 구조를 다시 확인한다."
    ],
    "code": [
      "benefit_monitor/collectors/html.py",
      "tests/test_remaining_sources.py"
    ],
    "history": [
      {
        "date": "2026-11-06",
        "note": "PR #25로 추가. 첫 실측 34건, 요청 2회."
      }
    ]
  }
}
