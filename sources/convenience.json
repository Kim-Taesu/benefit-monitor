  "runbook": {
    "checked_at": "2026-11-06",
    "entry_urls": [
      "https://cu.bgfretail.com/service/membership_info.do?category=service&depth2=2&depth3=1"
    ],
    "access": {
      "robots": "missing_404",
      "rendering": "server_html",
      "detail_access": "get",
      "conditions_in": "unknown",
